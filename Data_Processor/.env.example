# ───────────────────────────────────────
# Data Processor - Environment Variables
# ───────────────────────────────────────

# ─────── Server ─────────
PORT=8080
NODE_ENV=development
BASE_URL=http://localhost:8080

# ───────── Supabase ─────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here
SUPABASE_RAW_BUCKET=raw-data
SUPABASE_PROCESSED_BUCKET=processed-data

# ───── Open-Weather API ─────
OPENWEATHER_API_KEY=your-api-key-here
OPENWEATHER_LAT=39.3999
OPENWEATHER_LON=-8.2245

# ─────── Optional ────────
# ENTSOE_API_KEY=xxx
# ENTSOE_COUNTRY_CODE=10YPT-REN------W
